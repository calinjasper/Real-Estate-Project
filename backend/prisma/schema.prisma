// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(255)
  email         String        @unique @db.VarChar(255)
  password      String        @db.VarChar(255)
  phone         String?       @db.VarChar(50)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  properties    Property[]
  inquiries     Inquiry[]     @relation("BuyerInquiries")
  refreshTokens RefreshToken[]
}

model Property {
  id             Int             @id @default(autoincrement())
  title          String          @db.VarChar(500)
  description    String?         @db.Text
  price          Float
  city           String          @db.VarChar(100)
  state          String?         @db.VarChar(100)
  country        String?         @db.VarChar(100)
  address        String?         @db.VarChar(500)
  propertyType   String          @db.VarChar(50)
  bedrooms       Int
  bathrooms      Float
  area           Float?
  ownerId        Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyImages PropertyImage[]
  inquiries      Inquiry[]

  @@index([city])
  @@index([price])
  @@index([propertyType])
  @@index([bedrooms])
  @@index([ownerId])
  @@index([city, propertyType])
  @@index([city, price])
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  imageUrl   String   @db.VarChar(500)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id         Int      @id @default(autoincrement())
  propertyId Int
  buyerId    Int
  message    String   @db.Text
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer      User     @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, buyerId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

